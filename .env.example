# Copy to .env.local and fill in
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
FIRMS_MAP_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
# Required: keyed hash for IPs in the usage log (any long random string)
IP_HASH_SECRET=

# Required: key in the reviewer link (?key=...) that unlocks the reviewer bucket
REVIEWER_ACCESS_KEY=

# Basemap style for MapLibre. Defaults to OpenFreeMap Positron if unset.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Chat rate limits (optional, defaults shown)
# Public bucket: anyone without the reviewer key
CHAT_PUBLIC_HOURLY_PER_IP=5
CHAT_PUBLIC_DAILY=30

# Reviewer bucket: requests with a valid REVIEWER_ACCESS_KEY
CHAT_REVIEWER_HOURLY_PER_IP=60
CHAT_REVIEWER_DAILY=300

